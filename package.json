{
  "name": "zspeakly",
  "productName": "ZSpeakly",
  "version": "1.37.0",
  "private": true,
  "description": "ZSpeakly — офлайн голосовой ввод для Windows 11: диктовка в любое поле, словарь, AI-инструкции и буфер обмена.",
  "author": {
    "name": "ZSpeakly",
    "email": "hello@zspeakly.local"
  },
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "electron:dev": "node scripts/dev-electron.mjs",
    "electron": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "dist:dir": "npm run build && electron-builder --dir",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:main": "node scripts/smoke-main.mjs",
    "settings:index": "node scripts/build-settings-index.mjs",
    "settings:index:check": "node scripts/build-settings-index.mjs --check",
    "check:ipc": "node scripts/check-ipc.mjs",
    "check:wininput": "node scripts/check-wininput.cjs",
    "test:updater": "node scripts/smoke-updater.mjs",
    "check:settings": "node scripts/check-settings.mjs",
    "test:whisper": "node scripts/test-whisper-live.mjs",
    "audit:ui": "node scripts/audit-ui.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "electron-updater": "^6.8.11",
    "onnxruntime-node": "^1.31.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.469.0",
    "puppeteer-core": "^23.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "app.zspeakly.desktop",
    "productName": "ZSpeakly",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "icons"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "icons/**/*",
      "package.json",
      "!**/node_modules/onnxruntime-node/bin/napi-*/{darwin,linux}/**",
      "!**/node_modules/onnxruntime-web/**",
      "!**/node_modules/onnxruntime-common/**",
      "!**/node_modules/onnxruntime-node/bin/**/*cuda*",
      "!**/node_modules/onnxruntime-node/bin/**/*tensorrt*",
      "!**/node_modules/onnxruntime-node/bin/**/*dml*"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZSpeakly",
      "artifactName": "ZSpeakly-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "ZSpeakly-${version}-portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ttklon",
        "repo": "speak",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "build/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*.bin"
        ]
      },
      {
        "from": "electron/assets/gigaam",
        "to": "gigaam",
        "filter": [
          "**/*.onnx"
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ttklon/speak"
  }
}
